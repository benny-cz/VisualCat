<Project>
  <PropertyGroup>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Authors>Marek Strihavka</Authors>
    <Product>VisualCat</Product>
    <VersionPrefix>2.0.12</VersionPrefix>
    <!-- Android reserves two decimal digits for a rebuild of the same release
         version. Keep this checked in so tags and local packaging are reproducible. -->
    <VisualCatBuildNumber>0</VisualCatBuildNumber>

    <!-- The empty state prints the assembly's informational version, which is exactly what
         it should do — but the number it printed was 2.0.3 on a build made long after 2.0.3
         shipped, because nothing here had moved since (audit 2, E5). A build that is not a
         release says so in the version itself now, so "which build is this?" has an answer
         a screenshot can carry.

         The suffix used to depend on $(Configuration), which meant the one configuration
         nobody can test a release candidate in was the only one that admitted to not being
         a release: every Release build made after the 2.0.5 tag reported versionName=2.0.5
         and painted "VisualCat 2.0.5" on the empty state, indistinguishable from the shipped
         release that does not contain any of it (finding F-01). Release-ness is not a
         configuration. It is an explicit signal that the release pipeline sets and no
         developer build, CI check, or candidate build does:

             dotnet build -c Release -p:ReleaseChannel=stable

         Anything else is "2.0.12-dev+<commit>", which a screenshot can carry and a tester can
         read off the device. -->
    <VersionSuffix Condition="'$(VersionSuffix)' == '' And '$(ReleaseChannel)' != 'stable'">dev</VersionSuffix>
    <Description>Interactive, local-first Android logcat analysis with a severity-by-time heat map.</Description>
    <RepositoryUrl>https://github.com/benny-cz/VisualCat</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/benny-cz/VisualCat</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- XML files ship for every assembly while documentation is completed one
         stable public layer at a time. Domain is documented first. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>
</Project>
