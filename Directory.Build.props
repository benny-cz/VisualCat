<Project>
  <PropertyGroup>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Authors>Marek Strihavka</Authors>
    <Product>VisualCat</Product>
    <VersionPrefix>2.0.4</VersionPrefix>

    <!-- The empty state prints the assembly's informational version, which is exactly what
         it should do — but the number it printed was 2.0.3 on a build made long after 2.0.3
         shipped, because nothing here had moved since (audit 2, E5). A build that is not a
         release says so in the version itself now, so "which build is this?" has an answer
         a screenshot can carry.

         Negated rather than tested for Debug: $(Configuration) may still be empty this
         early in the evaluation, and the SDK fixes $(Version) before Directory.Build.targets
         is imported, so this is the last place a suffix can be added. A Release build passes
         the configuration as a global property, which is set before anything here runs. -->
    <VersionSuffix Condition="'$(Configuration)' != 'Release' And '$(VersionSuffix)' == ''">dev</VersionSuffix>
    <Description>Interactive, local-first Android logcat analysis with a severity-by-time heat map.</Description>
    <RepositoryUrl>https://github.com/benny-cz/VisualCat</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/benny-cz/VisualCat</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- XML files ship for every assembly while documentation is completed one
         stable public layer at a time. Domain is documented first. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>
</Project>
