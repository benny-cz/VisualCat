<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- The Android API level is pinned rather than floating with the workload so
         a workload update cannot silently change the level Google Play evaluates
         this app against. -->
    <TargetFramework>net10.0-android36.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ApplicationId>com.barebit.visualcat</ApplicationId>
    <ApplicationTitle>VisualCat</ApplicationTitle>
    <SupportedOSPlatformVersion>31</SupportedOSPlatformVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>

    <!-- The .NET Android SDK turns this on for Release, which trims the framework's resource
         strings: every BCL exception message then arrives as "ResourceKey, arg0, arg1"
         instead of a sentence. A status line on a device read
         "Failed · MakeException, (unclosed, 9, InsufficientClosingParentheses" while every
         test — Debug, and `dotnet test` — showed the ordinary sentence, which is exactly why
         it survived (finding F-04). The product no longer puts framework text in front of a
         reader (WorkspaceViewModel.Presentable), so this is a safety net rather than the fix:
         it keeps a diagnostic bundle and a stack trace legible when one is needed. -->
    <UseSystemResourceKeys>false</UseSystemResourceKeys>

    <!-- Google Play cannot grant READ_LOGS to an ordinary application and the production
         Wireless-debugging transport no longer needs it. Keep the privileged declaration out
         of Release/Play manifests by default, while preserving the established direct-capture
         developer loop in Debug. A controlled non-Play build may explicitly opt in with
         -p:VisualCatEnableReadLogsPermission=true. -->
    <VisualCatEnableReadLogsPermission Condition="'$(VisualCatEnableReadLogsPermission)' == '' And '$(Configuration)' == 'Debug'">true</VisualCatEnableReadLogsPermission>
    <VisualCatEnableReadLogsPermission Condition="'$(VisualCatEnableReadLogsPermission)' == ''">false</VisualCatEnableReadLogsPermission>
    <DefineConstants Condition="'$(VisualCatEnableReadLogsPermission)' == 'true'">$(DefineConstants);VISUALCAT_READ_LOGS</DefineConstants>

    <!-- Google Play never offers an update to a build installed by `adb install`, so the
         ordinary developer loop cannot exercise the in-app update path at all. Play Core ships
         a FakeAppUpdateManager inside the production app-update.aar that drives the whole flow
         from the device. It is off even in Debug — a fake update banner on every launch is its
         own kind of noise — and opted into with -p:VisualCatFakeAppUpdate=true.

         Gating it by constant keeps it out of the managed code and makes it unreachable in
         Release. It does not remove the Java class from the package: this project runs no R8
         shrinking (AndroidLinkTool is blank), so the ~10 KB class ships either way, inert
         because nothing constructs it. Enabling AndroidEnableProguard is the lever if that ever
         matters, and it is a separate change with its own verification. -->
    <VisualCatFakeAppUpdate Condition="'$(VisualCatFakeAppUpdate)' == ''">false</VisualCatFakeAppUpdate>
    <DefineConstants Condition="'$(VisualCatFakeAppUpdate)' == 'true' And '$(Configuration)' != 'Release'">$(DefineConstants);VISUALCAT_FAKE_APP_UPDATE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup>
    <!-- Google Play orders uploads by versionCode alone and refuses to accept the
         same one twice, on any track, so it is derived from the release version
         instead of a hand-maintained counter:

             major * 1000000 + minor * 10000 + patch * 100 + build

         2.0.9 -> 2000900, 2.1.0 with -p:VisualCatBuildNumber=3 -> 2010003.

         The old formula was major * 10000 + minor * 100 + patch, which has no room
         for a build counter: 2.1.0-alpha.1, 2.1.0-alpha.2 and 2.1.0-beta.1 all
         produced 20100, and Play refuses the second upload. Nothing was broken while
         no prerelease had ever been uploaded; an alpha/beta cadence — which the
         in-app update feature exists to serve — cannot start without this. The
         prerelease suffix lives in VersionSuffix and in the release tag and is not an
         input to any version code, so the counter has to be explicit.

         Monotonicity holds across the change: the largest code the old scheme could
         produce for any 2.x version is 29999 and the smallest this one produces for
         2.0.0 is 2000000, so every new code is strictly greater than every published
         one and no installed build is stranded. Play's ceiling is 2100000000.

         Promotion, not rebuilding, is how a tested build reaches production: the same
         bytes and the same version code move between tracks. Bump VisualCatBuildNumber
         only when the artifact itself is rebuilt. Re-uploading an unchanged version
         still works by overriding -p:ApplicationVersion=N. -->
    <VisualCatBuildNumber Condition="'$(VisualCatBuildNumber)' == ''">0</VisualCatBuildNumber>
    <AndroidReleaseMajor>$([System.Version]::Parse('$(VersionPrefix)').Major)</AndroidReleaseMajor>
    <AndroidReleaseMinor>$([System.Version]::Parse('$(VersionPrefix)').Minor)</AndroidReleaseMinor>
    <AndroidReleasePatch>$([System.Version]::Parse('$(VersionPrefix)').Build)</AndroidReleasePatch>

    <!-- Staged rather than one nested expression: MSBuild's property-function parser
         does not evaluate three levels of nesting and silently leaves the whole thing
         as literal text, which would reach aapt2 as a versionCode of "$([MSBuild]…". -->
    <_AndroidVersionCodeMajor>$([MSBuild]::Multiply($(AndroidReleaseMajor), 1000000))</_AndroidVersionCodeMajor>
    <_AndroidVersionCodeMinor>$([MSBuild]::Multiply($(AndroidReleaseMinor), 10000))</_AndroidVersionCodeMinor>
    <_AndroidVersionCodePatch>$([MSBuild]::Multiply($(AndroidReleasePatch), 100))</_AndroidVersionCodePatch>
    <_AndroidVersionCodeHigh>$([MSBuild]::Add($(_AndroidVersionCodeMajor), $(_AndroidVersionCodeMinor)))</_AndroidVersionCodeHigh>
    <_AndroidVersionCodeLow>$([MSBuild]::Add($(_AndroidVersionCodePatch), $(VisualCatBuildNumber)))</_AndroidVersionCodeLow>
    <ApplicationVersion>$([MSBuild]::Add($(_AndroidVersionCodeHigh), $(_AndroidVersionCodeLow)))</ApplicationVersion>
  </PropertyGroup>
  <!-- Each field owns exactly two digits, so a value of 100 silently borrows from the
       field above it and produces a code that overlaps a different release. Fail the
       build instead: a wrong version code cannot be withdrawn once Play has seen it. -->
  <Target Name="_VisualCatValidateVersionCode" BeforeTargets="BeforeBuild">
    <Error Condition="$([MSBuild]::ValueOrDefault('$(AndroidReleaseMinor)', '0')) &gt; 99"
           Text="VersionPrefix '$(VersionPrefix)' has minor version $(AndroidReleaseMinor); the Android version-code scheme allows 0-99. Widen the formula in VisualCat.Android.csproj before releasing it." />
    <Error Condition="$([MSBuild]::ValueOrDefault('$(AndroidReleasePatch)', '0')) &gt; 99"
           Text="VersionPrefix '$(VersionPrefix)' has patch version $(AndroidReleasePatch); the Android version-code scheme allows 0-99. Widen the formula in VisualCat.Android.csproj before releasing it." />
    <Error Condition="$([MSBuild]::ValueOrDefault('$(VisualCatBuildNumber)', '0')) &gt; 99 Or $([MSBuild]::ValueOrDefault('$(VisualCatBuildNumber)', '0')) &lt; 0"
           Text="VisualCatBuildNumber is '$(VisualCatBuildNumber)'; the Android version-code scheme allows 0-99." />
  </Target>
  <!-- A fake Play manager in a package intended for users would turn every launch into a
       fictional update offer. Fail closed even if a release command opts in by accident. -->
  <Target Name="_VisualCatRejectFakeUpdateInRelease" BeforeTargets="BeforeBuild">
    <Error Condition="'$(Configuration)' == 'Release' And '$(VisualCatFakeAppUpdate)' == 'true'"
           Text="VisualCatFakeAppUpdate is a device-test seam and cannot be enabled in Release." />
  </Target>
  <ItemGroup>
    <PackageReference Include="Avalonia.Android" />
    <PackageReference Include="Avalonia.Skia" />
    <PackageReference Include="Xamarin.AndroidX.Core" />
    <PackageReference Include="Xamarin.Google.Android.Play.App.Update" />
    <ProjectReference Include="../VisualCat.App/VisualCat.App.csproj" />
    <ProjectReference Include="../VisualCat.Android.AdbBinding/VisualCat.Android.AdbBinding.csproj" />
  </ItemGroup>
  <PropertyGroup>
    <!-- READ_LOGS is signature|privileged|development, so Android never prompts for it and
         the app cannot request it. A deploy uninstalls first, which drops the grant, so
         every `dotnet run` used to leave the on-device capture silently restricted to this
         app's own log lines — a capture of an idle app then looks broken rather than
         limited. Re-granting it as part of a debug deploy keeps the debug loop usable.
         Debug only: a Release or Play build must never assume the permission is held. -->
    <GrantReadLogsOnDeploy Condition="'$(GrantReadLogsOnDeploy)' == '' And '$(Configuration)' == 'Debug' And '$(VisualCatEnableReadLogsPermission)' == 'true'">true</GrantReadLogsOnDeploy>
    <GrantReadLogsOnDeploy Condition="'$(GrantReadLogsOnDeploy)' == ''">false</GrantReadLogsOnDeploy>
  </PropertyGroup>
  <Target Name="_GrantDebugLogPermission"
          AfterTargets="Install"
          Condition="'$(GrantReadLogsOnDeploy)' == 'true' And '$(VisualCatEnableReadLogsPermission)' == 'true'">
    <PropertyGroup>
      <_VisualCatAdbExe Condition="'$(AdbToolExe)' != ''">$(AdbToolExe)</_VisualCatAdbExe>
      <_VisualCatAdbExe Condition="'$(_VisualCatAdbExe)' == ''">adb</_VisualCatAdbExe>
      <_VisualCatAdb Condition="'$(AdbToolPath)' != ''">$([MSBuild]::NormalizePath('$(AdbToolPath)', '$(_VisualCatAdbExe)'))</_VisualCatAdb>
      <_VisualCatAdb Condition="'$(_VisualCatAdb)' == '' And '$(AndroidSdkDirectory)' != ''">$([MSBuild]::NormalizePath('$(AndroidSdkDirectory)', 'platform-tools', '$(_VisualCatAdbExe)'))</_VisualCatAdb>
      <_VisualCatAdb Condition="'$(_VisualCatAdb)' == ''">$(_VisualCatAdbExe)</_VisualCatAdb>
    </PropertyGroup>
    <!-- Never fails the build: the grant is a convenience, and a device that is offline or
         a platform that refuses it must not break a deploy that otherwise succeeded. -->
    <Exec Command="&quot;$(_VisualCatAdb)&quot; $(AdbTarget) shell pm grant $(ApplicationId) android.permission.READ_LOGS"
          ContinueOnError="true"
          IgnoreExitCode="true"
          StandardOutputImportance="low"
          StandardErrorImportance="low">
      <Output TaskParameter="ExitCode" PropertyName="_VisualCatGrantExit" />
    </Exec>
    <Message Condition="'$(_VisualCatGrantExit)' == '0'"
             Importance="high"
             Text="VisualCat: granted READ_LOGS — on-device capture can read the whole device log." />
    <Message Condition="'$(_VisualCatGrantExit)' != '0'"
             Importance="high"
             Text="VisualCat: could not grant READ_LOGS; on-device capture will only see this app's own lines. Grant it with: adb shell pm grant $(ApplicationId) android.permission.READ_LOGS" />
  </Target>
</Project>
