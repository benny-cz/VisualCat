<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">
  <!-- Normal install-time permissions used by explicit Wireless debugging capture. INTERNET
       permits the local ADB socket; the multicast permission lets Android 12-era devices
       receive mDNS while discovering adbd. READ_LOGS is added only by opted-in developer
       builds through AssemblyInfo.cs and is absent from Release/Play by default. -->
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
  <!-- Live capture is reader-initiated, potentially long-running data import. Android's
       data-sync foreground service keeps that work explicit and supplies an ongoing private
       notification with Stop and save while the screen is off. POST_NOTIFICATIONS is optional
       at runtime: denial hides the drawer notification but Android still exposes the service
       through Active apps and permits it to run. -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <!-- Some Java/AndroidX dependencies carry legacy assembly-level permission declarations.
       VisualCat never reads phone state or shared storage, and its minimum Android version does
       not use the legacy external-storage model. Remove them at the final manifest merge rather
       than relying on transitive package metadata to remain minimal. -->
  <uses-permission android:name="android.permission.READ_PHONE_STATE" tools:node="remove" />
  <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="remove" />
  <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" tools:node="remove" />
  <!-- Predictive back, explicitly, on every API level this app supports rather than only on
       the ones where Android turns it on by itself. Android 15 enables it by default for a
       target of API 35 or later and stops calling Activity.onBackPressed entirely; below that
       it stays off unless asked for. Leaving it implicit is what let one navigation
       mechanism be exercised on the API-36 device and a different one on the API-34 device,
       which is how a stock gesture Back walked past an open sheet to the launcher on a Pixel
       while a key Back closed the same sheet correctly (V2-21). MainActivity registers its
       own OnBackPressedCallback, so the app's layer stack answers the press either way. -->
  <application
    android:allowBackup="false"
    android:enableOnBackInvokedCallback="true"
    android:icon="@mipmap/ic_launcher"
    android:roundIcon="@mipmap/ic_launcher_round"
    android:usesCleartextTraffic="false">
    <provider
      android:name="androidx.core.content.FileProvider"
      android:authorities="${applicationId}.files"
      android:exported="false"
      android:grantUriPermissions="true">
      <meta-data
        android:name="android.support.FILE_PROVIDER_PATHS"
        android:resource="@xml/file_paths" />
    </provider>
  </application>
</manifest>
