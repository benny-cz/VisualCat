<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>vcat</AssemblyName>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>vcat</ToolCommandName>
    <PackageId>VisualCat.Cli</PackageId>
    <PackageOutputPath>$(MSBuildProjectDirectory)/nupkg</PackageOutputPath>
    <PackageReadmeFile>docs/CLI.md</PackageReadmeFile>
    <PackageIcon>visualcat-icon.png</PackageIcon>
    <PackageTags>android;logcat;adb;log-analysis;cli;local-first</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../VisualCat.Application/VisualCat.Application.csproj" />
    <ProjectReference Include="../VisualCat.Infrastructure/VisualCat.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../docs/CLI.md" Pack="true" PackagePath="docs/" />
    <None Include="../VisualCat.App/Assets/visualcat-icon.png" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
