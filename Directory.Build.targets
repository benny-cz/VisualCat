<Project>
  <PropertyGroup Condition="'$(IsTestProject)' == 'true'">
    <!-- Many integration tests deliberately own cancellation sources to exercise
         cancellation, graceful-stop, timeout, and partial-session behavior. The
         xUnit v3 blanket rule cannot distinguish those from runner cancellation. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>
</Project>
